package test:varargs-name-clash@1.0.0;

world system { export batch-service; }

/// @nexus.endpoint "batches"
interface batch-service {
  /// @nexus.unwrap
  record batch-item {
    value: string,
  }

  resource batch {
    constructor(batch-id: string);

    // The API name of the items is the name of another parameter.
    /// @nexus.varargs name="label"
    add-items: func(label: option<string>, items: list<batch-item>) -> add-items-response;
  }

  record add-items-request {
    batch-id: string,
    items: list<batch-item>,
    label: option<string>,
  }

  record add-items-response {
    last-item-id: option<string>,
  }

  add-items: func(request: add-items-request) -> add-items-response;
}
