package test:result-field-with-output-transform@1.0.0;

world system { export batch-service; }

/// @nexus.endpoint "batches"
interface batch-service {
  /// @nexus.unwrap
  record batch-item {
    value: string,
  }

  resource batch {
    constructor(batch-id: string);

    // The transform gives another value, so the method can't read the response.
    /// @nexus.result-field "last-item-id"
    add-items: func(items: list<batch-item>) -> add-items-response;
  }

  record add-items-request {
    batch-id: string,
    items: list<batch-item>,
    label: option<string>,
  }

  record add-items-response {
    last-item-id: option<string>,
  }

  /// @nexus.output-transform python-type="str" python="result.last_item_id or ''"
  add-items: func(request: add-items-request) -> add-items-response;
}
