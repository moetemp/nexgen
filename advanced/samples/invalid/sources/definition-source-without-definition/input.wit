package temporal:definition-source-without-definition@1.0.0;

world system { export job-service; }

/// @nexus.endpoint "jobs"
interface job-service {
  record start-job-request {
    /// @nexus.source targets="workflow" python="job_id(definition)" typescript="jobId(definition)"
    ///   go="JobId(definition)" dotnet="Context.JobId(definition)"
    id: string,
  }

  // The operation returns no resource with a definition, so no call has a definition.
  start-job: func(request: start-job-request);
}
