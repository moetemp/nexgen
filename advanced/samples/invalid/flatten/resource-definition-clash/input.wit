package test:resource-definition-clash@1.0.0;

world system { export history-service; }

/// @nexus.endpoint "history"
interface history-service {
  type placeholder = string;

  /// @nexus.type-parameter
  type value-t = placeholder;

  record workflow-execution {
    workflow-id: string,
    definition: option<string>,
  }

  record set-request {
    workflow-id: string,
    value: value-t,
  }

  // The factory takes the definition first, so a promoted `definition` would clash with it.
  /// @nexus.type-parameter "value-t"
  /// @nexus.definition python="temporal_support.JobDefinition"
  /// @nexus.flatten-in-api param="execution" fields="workflow-id definition"
  resource run {
    constructor(execution: workflow-execution);

    /// @nexus.operation "set"
    set: func(workflow-id: string, value: value-t);
  }

  set: func(request: set-request);
}
