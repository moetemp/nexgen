package test:source-field-promoted@1.0.0;

world system { export history-service; }

/// @nexus.endpoint "history"
interface history-service {
  record workflow-execution {
    workflow-id: string,
    run-id: option<string>,
  }

  record get-history-request {
    namespace: string,
    // The call takes `run-id`, so a source can't fill it too.
    /// @nexus.flatten-in-api fields="workflow-id run-id"
    /// @nexus.source field="run-id" targets="workflow" python="workflow_run_id()"
    execution: option<workflow-execution>,
  }

  get-history: func(request: get-history-request);
}
