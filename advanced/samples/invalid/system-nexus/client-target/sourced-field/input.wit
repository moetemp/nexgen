// The field's only source is for the workflow target, so the client target can't fill it.
// temporalio/nexgen#301 tracks taking such a field as a parameter instead.
package temporal:client-sourced-field@1.0.0;

world system { export namespace-service; }

/// @nexus.endpoint "__temporal_system"
interface namespace-service {
  /// @nexus.proto "temporal.api.workflowservice.v1.DescribeNamespaceRequest"
  record describe-request {
    /// @nexus.source target="workflow" python="workflow_namespace()"
    namespace: string,
    id: string,
    weak-consistency: option<bool>,
  }

  /// @nexus.proto "temporal.api.workflowservice.v1.RequestCancelWorkflowExecutionResponse"
  record describe-response {}

  describe: func(request: describe-request) -> describe-response;
}
