package temporal:stream-writer@1.0.0;

world writer {
  export stream-writer;
}

// A package apart from the stream service, as in Brook. The writer has no endpoint, since the
// client serves it in process. It uses records of the stream service, as Brook's writer does.
/// @nexus.service-name "streamsample.v1.StreamWriter"
interface stream-writer {
  use nexus:temporal-types/model@1.0.0.{duration};
  use temporal:stream-service/stream-service@1.0.0.{producer, stream-ref};

  /// @nexus.proto "streamsample.v1.OpenWriterRequest" typescript-import="#streamsample"
  record open-writer-request {
    %stream: option<stream-ref>,
    producer: option<producer>,
    max-retry-duration: option<duration>,
  }

  /// @nexus.proto "streamsample.v1.CloseWritersRequest" typescript-import="#streamsample"
  record close-writers-request {
  }

  /// @nexus.proto "streamsample.v1.CloseWritersResponse" typescript-import="#streamsample"
  record close-writers-response {
    failed: option<s32>,
  }

  /// @nexus.doc "An open writer of one stream."
  resource writer {
    constructor(writer-id: u64);

    /// @nexus.operation "close-writer"
    close: func() -> close-writer-response;
  }

  /// @nexus.proto "streamsample.v1.OpenWriterResponse" typescript-import="#streamsample"
  type writer-result = own<writer>;

  /// @nexus.operation name="OpenWriter"
  open-writer: func(request: open-writer-request) -> writer-result;

  /// @nexus.doc "Drop every open writer, for example at shutdown."
  /// @nexus.operation name="CloseWriters"
  close-writers: func(request: close-writers-request) -> close-writers-response;

  /// @nexus.proto "streamsample.v1.CloseWriterRequest" typescript-import="#streamsample"
  record close-writer-request {
    writer-id: option<u64>,
  }

  /// @nexus.proto "streamsample.v1.CloseWriterResponse" typescript-import="#streamsample"
  record close-writer-response {
    /// @nexus.doc "The offset of the newest record the writer wrote. Zero if it wrote none."
    last-offset: option<s64>,
  }

  /// @nexus.operation name="CloseWriter"
  close-writer: func(request: close-writer-request) -> close-writer-response;
}
