package temporal:user-service@1.0.0;

world system {
  export user-service;
}

interface user-service {
  resource user {
    constructor(user-id: string, email: string);

    update-email: func(email: string) -> user-result;
    notify: func(reason: option<string>, channels: list<string>, sender: string);
  }

  type user-result = own<user>;

  record get-user-request {
    user-id: string,
  }

  record update-email-request {
    user-id: string,
    email: string,
  }

  record notify-request {
    user-id: string,
    reason: option<string>,
    channels: list<string>,
    sender: string,
    // The user's own email has the same name and another type, so it must not fill this field.
    email: option<bool>,
  }

  // No field, so a caller method takes no parameter.
  record notify-all-request {
  }

  get-user: func(request: get-user-request) -> user-result;
  update-email: func(request: update-email-request) -> user-result;
  notify: func(request: notify-request);
  notify-all: func(request: notify-all-request);
}
