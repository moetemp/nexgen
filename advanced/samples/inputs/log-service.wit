package temporal:log-service@1.0.0;

world system {
  export log-service;
}

/// @nexus.endpoint "logs"
interface log-service {
  record entry {
    offset: option<s64>,
    text: string,
  }

  record append-request {
    log-id: string,
    texts: list<string>,
  }

  record append-response {
    last-offset: option<s64>,
  }

  record read-request {
    log-id: string,
    from-offset: option<s64>,
    wait-ms: option<s64>,
  }

  record read-response {
    entries: list<entry>,
    next-offset: option<s64>,
    done: option<bool>,
  }

  append: func(request: append-request) -> append-response;

  /// @nexus.doc "Read the entries from an offset. The service waits for new entries."
  /// @nexus.long-poll
  ///   wait-field="wait-ms"
  ///   max-wait-ms="30000"
  ///   result-field="entries"
  ///   done-field="done"
  ///   offset-field="from-offset"
  ///   next-offset-field="next-offset"
  read: func(request: read-request) -> read-response;
}
