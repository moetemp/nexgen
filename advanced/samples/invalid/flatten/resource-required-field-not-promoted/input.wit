package temporal:nexus@1.0.0;

world system { export history-service; }

/// @nexus.endpoint "history"
interface history-service {
  /// @nexus.proto "temporal.api.common.v1.WorkflowExecution"
  record workflow-execution {
    workflow-id: string,
    run-id: option<string>,
  }

  // The factory has no fill, so it must take the required `workflow-id`.
  /// @nexus.flatten-in-api param="execution" fields="run-id"
  resource run {
    constructor(execution: workflow-execution);
  }
}
