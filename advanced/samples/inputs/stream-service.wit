package temporal:stream-service@1.0.0;

world system {
  export stream-service;
}

/// @nexus.endpoint "streams"
interface stream-service {
  use nexus:temporal-types/model@1.0.0.{duration, payload};

  /// @nexus.doc "Identifies one stream."
  record stream-ref {
    id: string,
    owner-id: option<string>,
  }

  record append-record {
    topic: string,
    body: payload,
  }

  enum record-kind {
    data,
    close,
  }

  enum stream-status {
    open,
    closed,
  }

  record stream-record {
    kind: record-kind,
    offset: s64,
    topic: option<string>,
    body: option<payload>,
  }

  record create-stream-request {
    %ref: stream-ref,
    retention: option<duration>,
  }

  record append-records-request {
    %stream: stream-ref,
    records: list<append-record>,
    sequence: option<s64>,
  }

  record append-records-response {
    first-offset: s64,
    last-offset: s64,
  }

  record close-stream-request {
    %stream: stream-ref,
    %result: option<payload>,
  }

  record close-stream-response {
  }

  record read-records-request {
    %stream: stream-ref,
    from-offset: option<s64>,
    topics: list<string>,
    max-records: option<s32>,
    wait: option<duration>,
  }

  record read-records-response {
    records: list<stream-record>,
    next-offset: option<s64>,
    done: option<bool>,
  }

  record describe-stream-request {
    %stream: stream-ref,
  }

  record describe-stream-response {
    status: stream-status,
    last-offset: option<s64>,
  }

  /// @nexus.doc "A handle on one stream, built from its ref."
  resource %stream {
    constructor(%stream: stream-ref);

    /// @nexus.doc "Append records. The answer has the first and the last offset."
    append-records: func(
      records: list<append-record>,
      sequence: option<s64>,
    ) -> append-records-response;

    /// @nexus.operation "close-stream"
    close: func(%result: option<payload>);

    /// @nexus.doc "Read one page of records from an offset."
    read-records: func(
      from-offset: option<s64>,
      topics: list<string>,
      max-records: option<s32>,
      wait: option<duration>,
    ) -> read-records-response;

    /// @nexus.operation "describe-stream"
    describe: func() -> describe-stream-response;
  }

  record create-stream-result {
    %stream: own<%stream>,
    created: bool,
  }

  create-stream: func(request: create-stream-request) -> create-stream-result;
  append-records: func(request: append-records-request) -> append-records-response;
  close-stream: func(request: close-stream-request) -> close-stream-response;
  read-records: func(request: read-records-request) -> read-records-response;
  describe-stream: func(request: describe-stream-request) -> describe-stream-response;
}
