package test:go-varargs@1.0.0;

world system { export batch-service; }

/// @nexus.endpoint "batches"
interface batch-service {
  resource batch {
    constructor(batch-id: string);

    /// @nexus.varargs name="values"
    add-items: func(items: list<string>);
  }

  record add-items-request {
    batch-id: string,
    items: list<string>,
  }

  add-items: func(request: add-items-request);
}
