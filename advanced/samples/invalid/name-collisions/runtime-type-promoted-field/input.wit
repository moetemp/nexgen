package test:runtime-type-promoted-field@1.0.0;

world system { export holder-service; }

// The runtime type of value-t is `value_type` in Python, which the factory takes too.
/// @nexus.endpoint "holders"
interface holder-service {
  type placeholder = string;

  /// @nexus.type-parameter
  type value-t = placeholder;

  record holder-ref {
    id: string,
    value-type: option<string>,
  }

  record set-request {
    ref: holder-ref,
    value: value-t,
  }

  /// @nexus.type-parameter "value-t"
  /// @nexus.flatten-in-api param="ref" fields="id value-type"
  resource holder {
    constructor(ref: holder-ref);

    /// @nexus.operation "set"
    set: func(value: value-t);
  }

  set: func(request: set-request);
}
