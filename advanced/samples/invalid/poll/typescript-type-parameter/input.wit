package temporal:poll-typescript-type-parameter@1.0.0;

world service { export reader; }

/// @nexus.endpoint "reader"
interface reader {
  type placeholder = string;

  /// @nexus.type-parameter
  type context-t = placeholder;

  record read-request { context: context-t, offset: option<s64> }
  record read-response { done: option<bool> }

  /// @nexus.poll typescript="nextRead" targets="client"
  read: func(request: read-request) -> read-response;
}
